{
  "name": "dominance",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.2.22",
  "engines": {
    "node": "24.16.0",
    "bun": "1.2.22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "back:lint": "bun run --filter @dominance/backend lint",
    "back:dev": "bun run --filter @dominance/backend start:dev",
    "front:dev": "bun run --filter @dominance/frontend dev",
    "front:lint": "bun run --filter @dominance/frontend lint"
  }
}